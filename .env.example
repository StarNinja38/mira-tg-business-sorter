# Telegram
BOT_TOKEN=
OWNER_USER_ID=          # your telegram user_id (get it from @userinfobot)

# Mode (saved to DB after first run; start ALWAYS on observe)
MODE=observe            # observe | active

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Logs and data
LOG_LEVEL=INFO
DB_PATH=./data/bot.db

# Budget (hard stop LLM when month spend reaches this; 0 = unlimited)
ANTHROPIC_MONTHLY_BUDGET=5.0
TIMEZONE=Europe/Moscow
DAILY_PHOTO_LIMIT=30

# Integrations (optional)
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_CONTACTS_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=/opt/tg-business-sorter/gcal-service.json

# Privacy (default off = current behaviour)
EXCLUDE_FRIEND_FROM_CLOUD=false   # FRIEND-текст не уходит в Notion
REDACT_PII=false                  # маскировать email/телефоны/карты перед LLM
